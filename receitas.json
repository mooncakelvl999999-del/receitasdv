```python
import json

records = []
for _, row in df.iterrows():
    ingredients = [
        row[f'Ingredient {i}']
        for i in range(1, 6)
        if pd.notna(row[f'Ingredient {i}']) and str(row[f'Ingredient {i}']).strip() != ''
    ]
    records.append({
        "id": int(row['ID']),
        "type": row['Type'],
        "rarity": row['Rarity'],
        "name": row['Name'],
        "ingredients": ingredients,
        "effect_type": row['Effect Type'],
        "percentage": float(row['%']),
        "hero_emblem": int(row['Hero Emblem'])
    })

json_output = json.dumps(records, indent=2, ensure_ascii=False)
print(f"Total entries: {len(records)}")
print("First 2 entries:")
print(json.dumps(records[:2], indent=2, ensure_ascii=False))


```

